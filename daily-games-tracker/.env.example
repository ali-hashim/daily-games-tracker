# Local placeholders; copy to .dev.vars for local Pages Functions only.
# Never commit real credentials in .env or .dev.vars files.
APP_ENV="local"
APP_ORIGIN="http://localhost:8788"
CLOUDFLARE_ACCESS_DOMAIN="https://access.example.invalid"
CLOUDFLARE_ACCESS_AUD="replace-with-access-application-audience"
ADMIN_EMAIL="admin@example.test"
# SHORTCUT_BUCKET is an R2 binding declared in wrangler.jsonc, not a local environment variable.
