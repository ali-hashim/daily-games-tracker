{
  "name": "daily-games-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 0.0.0.0",
    "build": "npm run typecheck:app && vite build --configLoader runner",
    "typecheck": "npm run typecheck:app && npm run typecheck:functions && npm run typecheck:sw && npm run typecheck:tests",
    "typecheck:app": "tsc -p tsconfig.app.json",
    "typecheck:functions": "tsc -p tsconfig.functions.json",
    "typecheck:sw": "tsc -p tsconfig.sw.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "preview": "vite preview --configLoader runner",
    "dev:pages": "wrangler pages dev dist",
    "deploy:preview": "wrangler pages deploy dist --project-name example-pages-project --branch preview",
    "deploy:production": "wrangler pages deploy dist --project-name example-pages-project --branch main",
    "db:local:migrate": "wrangler d1 migrations apply DB --local",
    "db:preview:migrate": "wrangler d1 migrations apply DB --remote --env preview",
    "db:production:migrate": "wrangler d1 migrations apply DB --remote --env production",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:database": "node scripts/test_schema.mjs",
    "test:smoke": "node scripts/smoke_pages.mjs",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "jose": "6.2.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261021.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "miniflare": "5.20261019.1-beta",
    "prettier": "3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.72.0",
    "vite": "^7.0.0",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  }
}
