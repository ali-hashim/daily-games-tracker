{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "example-pages-project",
  "compatibility_date": "2026-10-20",
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "example-local-db",
      // Inert local placeholder. Provision private runtime IDs before any deployment.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "preview_database_id": "DB",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "APP_ENV": "local",
  },
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "example-preview-db",
          // Inert placeholder. Keep real runtime IDs outside the public repository.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "APP_ENV": "preview",
      },
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "example-production-db",
          // Inert placeholder. Keep real runtime IDs outside the public repository.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "APP_ENV": "production",
      },
    },
  },
}
