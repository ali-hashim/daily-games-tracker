#include 'actions/web'
#include 'actions/sharing'
#define name WHT Completion Probe
#define mac false

// Preserve a native dictionary-key variable reference. Cherri's built-in openURL
// requires a statically text-typed argument, while dictionary values are dynamic.
action 'openurl' whtOpenURL(variable url: 'WFInput') {
    "Show-WFInput": true
}

// JSON text fixtures keep null distinct from an empty string. The only URL target is synthetic.
const presentJson = text('{"scoreboard_text":"Synthetic scoreboard","completion_message":"Synthetic completion","wht_url":"https://example.invalid/wht"}')
const emptyJson = text('{"scoreboard_text":"","completion_message":"Synthetic empty fixture","wht_url":"https://example.invalid/wht-empty"}')
const nullJson = text('{"scoreboard_text":null,"completion_message":"Synthetic null fixture","wht_url":"https://example.invalid/wht-null"}')
const missingJson = text('{"completion_message":"Synthetic missing fixture","wht_url":"https://example.invalid/wht-missing"}')
@presentResponse = getDictionary(presentJson)
@emptyResponse = getDictionary(emptyJson)
@nullResponse = getDictionary(nullJson)
@missingResponse = getDictionary(missingJson)
@fixtureResponse = @presentResponse
@scoreboardText = getValue(@fixtureResponse, "scoreboard_text")
@completionMessage = getValue(@fixtureResponse, "completion_message")
@whtURL = getValue(@fixtureResponse, "wht_url")

if @scoreboardText {
    setClipboard(@scoreboardText)
}

menu @completionMessage {
    item "Close":
        stop()
    item "Open WHT":
        whtOpenURL(@whtURL)
        stop()
}
stop()
