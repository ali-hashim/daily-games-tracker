#include 'actions/web'
#include 'actions/sharing'
#define name WHT Completion Probe
#define mac false

// JSON text fixtures keep null distinct from an empty string. The only URL target is synthetic.
const presentJson = text('{"scoreboard_text":"Synthetic scoreboard","completion_message":"Synthetic completion","wht_url":"https://example.invalid/wht"}')
const emptyJson = text('{"scoreboard_text":"","completion_message":"Synthetic empty fixture","wht_url":"https://example.invalid/wht"}')
const nullJson = text('{"scoreboard_text":null,"completion_message":"Synthetic null fixture","wht_url":"https://example.invalid/wht"}')
const missingJson = text('{"completion_message":"Synthetic missing fixture","wht_url":"https://example.invalid/wht"}')
const presentResponse = getDictionary(presentJson)
const emptyResponse = getDictionary(emptyJson)
const nullResponse = getDictionary(nullJson)
const missingResponse = getDictionary(missingJson)
const presentScoreboard = presentResponse['scoreboard_text']
const emptyScoreboard = emptyResponse['scoreboard_text']
const nullScoreboard = nullResponse['scoreboard_text']
const missingScoreboard = missingResponse['scoreboard_text']
const completionMessage = presentResponse['completion_message']
const whtURL = presentResponse['wht_url']

if presentScoreboard {
    setClipboard(presentScoreboard)
}
if emptyScoreboard {
    setClipboard(emptyScoreboard)
}
if nullScoreboard {
    setClipboard(nullScoreboard)
}
if missingScoreboard {
    setClipboard(missingScoreboard)
}

menu completionMessage {
    item "Close":
        stop()
    item "Open WHT":
        openURL(whtURL)
        stop()
}
stop()
