/*
  Content-Security-Policy: default-src 'self'; connect-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Every SPA route resolves to this shell. Browser HTTP caching is disabled;
# the service worker keeps the versioned app-shell copy explicitly.
/index.html
  Cache-Control: no-store

/api/*
  Cache-Control: no-store

/admin
  Cache-Control: no-store

/admin/*
  Cache-Control: no-store

/register
  Cache-Control: no-store

/register/*
  Cache-Control: no-store

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/login
  Cache-Control: no-store
  Referrer-Policy: no-referrer
